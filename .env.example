# Copy this file to .env.local and fill in real values for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# Vercel Blob storage — created automatically when you connect a Blob store
# to this project in the Vercel dashboard (Storage tab -> Create Database -> Blob).
BLOB_READ_WRITE_TOKEN=

# Admin panel login (choose your own values — keep them secret).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Any long random string, used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
